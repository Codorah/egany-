rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive rules for local development and preview environment to support both authenticated and local guest users
    
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /groups/{groupId} {
      allow read, write: if true;
    }
    
    match /groups/{groupId}/contributions/{contributionId} {
      allow read, write: if true;
    }
    
    match /users/{userId}/walletTransactions/{transactionId} {
      allow read, write: if true;
    }
    
    match /groups/{groupId}/messages/{messageId} {
      allow read, write: if true;
    }
    
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    match /invitations/{invitationId} {
      allow read, write: if true;
    }
  }
}
