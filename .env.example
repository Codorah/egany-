# Supabase (base de données, auth, storage — remplace Firestore/Firebase Auth/Storage)
# Dashboard Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paydunya (Mobile Money checkout - Wave, Orange Money, MTN...)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=sandbox

# Firebase Cloud Messaging - Web Push certificate (VAPID) key.
# Firebase Console > Project Settings > Cloud Messaging > Web configuration.
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK service account (JSON, as a single-line string), used
# server-side to actually send push notifications via FCM.
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Africa's Talking (SMS notifications)
# Dashboard: Settings > API Key
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Twilio (WhatsApp notifications)
# Console > Account Info (SID/Token) + Messaging > Try WhatsApp for the sandbox number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
