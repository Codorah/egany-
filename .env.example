# Supabase (base de données, auth, storage — remplace Firestore/Firebase Auth/Storage)
# Dashboard Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé service Supabase — SERVEUR UNIQUEMENT, ne jamais préfixer VITE_ (tout ce
# qui commence par VITE_ est embarqué dans le bundle envoyé au navigateur).
# Elle contourne les politiques RLS : c'est elle qui permet au webhook Paydunya
# de créditer un portefeuille, ce que l'application n'a plus le droit de faire.
# Dashboard Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Paydunya (Mobile Money checkout — Flooz, T-Money...)
# Renseigner aussi l'URL de notification (IPN) dans le tableau de bord Paydunya :
#   https://<votre-domaine>/api/paydunya-webhook
# Sans elle, aucune recharge ne sera jamais créditée.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=sandbox

# Firebase Cloud Messaging - Web Push certificate (VAPID) key.
# Firebase Console > Project Settings > Cloud Messaging > Web configuration.
VITE_FIREBASE_VAPID_KEY=

# Firebase Admin SDK service account (JSON, as a single-line string), used
# server-side to actually send push notifications via FCM.
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Africa's Talking (SMS notifications)
# Dashboard: Settings > API Key
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Twilio (WhatsApp notifications)
# Console > Account Info (SID/Token) + Messaging > Try WhatsApp for the sandbox number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Anthropic (AI Assistant / Copilote)
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
